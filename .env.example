# API Key for authentication (optional but recommended)
API_KEY=your_secure_api_key_here

# Server port
PORT=3000

# Multi-account configuration (semicolon-separated)
# Format: id,profile_path,email;id2,profile_path2,email2
# Example: account1,/app/deepseek_profiles/account1,user1@example.com;account2,/app/deepseek_profiles/account2,user2@example.com
DEEPSEEK_ACCOUNTS=default,/app/deepseek_profile

# Playwright settings
PLAYWRIGHT_HEADLESS=true

# Timeout for chat input detection (milliseconds)
DEEPSPROXY_CHAT_INPUT_TIMEOUT_MS=8000

# Health check interval for accounts (milliseconds)
DEEPSPROXY_HEALTH_CHECK_INTERVAL_MS=60000

# PoW header cache TTL (milliseconds)
DEEPSPROXY_POW_CACHE_TTL_MS=30000
